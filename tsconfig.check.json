{
  "//": "Standalone compile for npm run check:board. Not used by Next.",
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    "rootDir": "src",
    "baseUrl": ".",
    "paths": { "@/*": ["src/*"] },
    "outDir": "node_modules/.cache/board-check",
    "skipLibCheck": true,
    "strict": true,
    "esModuleInterop": true,
    "noEmitOnError": true
  },
  "include": ["src/board/**/*.ts"]
}
